{
  "name": "chit-restaurant-desktop-pos",
  "version": "1.0.0",
  "description": "Chit Restaurant POS - Desktop Application with Thermal ESC/POS Printing & Offline Sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "pos",
    "restaurant",
    "billing",
    "electron",
    "thermal-printer",
    "kot"
  ],
  "author": "Chit Restaurant POS",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chitrestaurant.pos",
    "productName": "Chit Restaurant POS",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
